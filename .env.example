# Server binding. Local-only is the safe default; set AVC_HOST to a LAN IP only
# when you intentionally want other devices on your trusted network to connect.
AVC_HOST=127.0.0.1
AVC_PORT=3000

# AI provider: template (honest offline templates), ollama (local), or openai.
AI_PROVIDER=template

# Local Ollama, for actual local script/SEO generation.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# Optional SearXNG instance URL. JSON output must be enabled in that instance.
SEARXNG_URL=

# Optional custom path to FFmpeg executable. Otherwise FFmpeg must be on PATH.
FFMPEG_PATH=

# Optional cloud AI provider. Set AI_PROVIDER=openai to use it.
# Keep this value server-side; never expose it with a NEXT_PUBLIC_ prefix.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
